<Window x:Class="Voxa.PreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voxa · Listening" Width="530" Height="190" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Border Margin="8" Background="#F21A1E2C" CornerRadius="20" BorderBrush="#605A7D" BorderThickness="1" Padding="22,18">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/></Border.Effect>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="#AA98FF" FontSize="14" Margin="0,0,9,0"/><TextBlock x:Name="Heading" Text="正在聆听" Foreground="#F0EDF9" FontSize="14" FontWeight="SemiBold"/></StackPanel><StackPanel x:Name="Wave" Orientation="Horizontal" HorizontalAlignment="Right" Height="20" VerticalAlignment="Center"/></Grid>
            <TextBlock Grid.Row="1" x:Name="Transcript" Text="说出你的想法……" Foreground="#D9DFF0" FontSize="16" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,14,0,12"/>
            <Grid Grid.Row="2"><TextBlock Text="右 Ctrl × 2  完成" Foreground="#A79AC7" FontSize="11"/><TextBlock Text="Ctrl + Alt + Esc  取消" Foreground="#78849D" FontSize="11" HorizontalAlignment="Right"/></Grid>
        </Grid>
    </Border>
</Window>
