<Window x:Class="Voxa.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voxa" Width="1040" Height="780" MinWidth="920" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="#10121A" Foreground="#F1F3FA" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#929AAF"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#262B3B"/><Setter Property="Foreground" Value="#E6E9F4"/>
            <Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E6E9F4"/><Setter Property="Background" Value="#242A39"/><Setter Property="Padding" Value="14,10"/></Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EFF1F8"/><Setter Property="Background" Value="#242A39"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#242A39" CornerRadius="10" BorderBrush="#373F55" BorderThickness="1"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#A6B1CC" FontSize="20"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="14,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#242A39" CornerRadius="10" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Width="48" Height="28"><Border x:Name="Track" CornerRadius="14" Background="#3A4154"/><Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="4"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#9A88FF"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#10121A" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
        <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#151823" BorderBrush="#242938" BorderThickness="0,0,1,0" Padding="22,28">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"><Border Background="#9A88FF" CornerRadius="12" Width="42" Height="42"><TextBlock Text="V" Foreground="#161323" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="voxa" FontSize="26" FontWeight="Bold"/><TextBlock Text="VOICE WORKSPACE" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
                <Border Grid.Row="1" Background="#29263D" CornerRadius="10" Margin="0,38,0,0" Padding="15,13"><TextBlock Text="◉   语音输入" Foreground="#C4B9FF" FontWeight="SemiBold"/></Border>
                <StackPanel Grid.Row="3"><TextBlock Text="为自然表达而设计" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="本机识别 · 无需 API Key" Foreground="#697288" FontSize="11" Margin="0,7,0,20"/><Button Content="退出 Voxa" Click="QuitClick" HorizontalAlignment="Left" Padding="14,9"/></StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24,32,20">
                <Grid><StackPanel><TextBlock Text="让想法，流畅落字。" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="点击输入框，双击右 Ctrl，然后自然地说。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#20312E" CornerRadius="18" Padding="12,7"><TextBlock x:Name="StateBadge" Text="●  准备就绪" Foreground="#8EE3BD" FontSize="12"/></Border></Grid>
                <Border CornerRadius="18" BorderBrush="#4C436F" BorderThickness="1" Padding="18" Margin="0,20,0,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#302742" Offset="0"/><GradientStop Color="#1C2335" Offset="1"/></LinearGradientBrush></Border.Background>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="随时开口，即刻输入" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="双击开始，再双击完成。停顿也能自动落字。" Foreground="#B0ACC4" Margin="0,9,0,20"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="TriggerStatus" Text="●  全局快捷键已启用" Foreground="#8EE3BD" FontSize="12"/><TextBlock Text="  ·  不抢输入焦点" Foreground="#8F8DA5" FontSize="12"/></StackPanel></StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0"><Border Background="#161A27" BorderBrush="#625B7D" BorderThickness="1" CornerRadius="13" Padding="22,14"><TextBlock Text="右 Ctrl" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border><TextBlock Text="× 2  快速轻按" Foreground="#B7AACF" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#1A1E2B" CornerRadius="16" Padding="18"><StackPanel><TextBlock Text="识别语言" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="选择本机已安装的语音语言" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,16"/><ComboBox x:Name="Languages" Height="43" SelectionChanged="LanguageChanged" AutomationProperties.Name="识别语言"/></StackPanel></Border>
                    <Border Grid.Column="2" Background="#1A1E2B" CornerRadius="16" Padding="18"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="停顿后自动输入" FontWeight="SemiBold" FontSize="16"/><CheckBox Grid.Column="1" x:Name="AutoFinish" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Checked="AutoFinishChanged" Unchecked="AutoFinishChanged" AutomationProperties.Name="停顿后自动输入"/></Grid><TextBlock Text="说完稍作停顿，文字自动到达光标。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,13,0,12" TextWrapping="Wrap"/><TextBlock Text="关闭后，双击右 Ctrl 手动完成。" Foreground="#707A91" FontSize="12"/></StackPanel></Border>
                </Grid>
                <Border Background="#1A1E2B" CornerRadius="16" Padding="18" Margin="0,18,0,0"><StackPanel>
                    <Grid><TextBlock Text="最近转写" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ClearButton" Content="清除" Padding="12,7" Background="Transparent" Click="ClearClick"/><Button x:Name="CopyButton" Content="复制文字" Padding="14,7" Margin="8,0,0,0" Background="#9A88FF" Foreground="#171425" Click="CopyClick"/></StackPanel></Grid>
                    <Grid Margin="0,15,0,0" MinHeight="80"><TextBox x:Name="Result" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxHeight="140" Background="Transparent" BorderThickness="0" Foreground="#DDE2F1" CaretBrush="White" FontSize="15" Padding="0,4" AutomationProperties.Name="最近转写"/><TextBlock x:Name="EmptyResult" Text="你的下一段表达，从这里开始。&#10;完成后的文字会留在这里，方便再次复制。" Foreground="#737E96" FontSize="14" LineHeight="26" IsHitTestVisible="False" TextWrapping="Wrap"/></Grid>
                    <Border BorderBrush="#2D3446" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" x:Name="Status" Text="点击输入框，双击右 Ctrl 开始听写。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/><Button x:Name="CancelButton" Grid.Column="1" Content="取消听写" Padding="10,6" Margin="12,0,0,0" Click="CancelClick"/></Grid></Border>
                </StackPanel></Border>
                <Grid Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><Button Content="麦克风权限 ↗" Background="Transparent" Foreground="#A6B0C7" Padding="0,7,16,7" Click="MicrophoneClick"/><Button Content="语言设置 ↗" Background="Transparent" Foreground="#A6B0C7" Padding="0,7,16,7" Click="LanguageSettingsClick"/></StackPanel><TextBlock Text="关闭窗口后，Voxa 留在系统托盘。" Foreground="#707A91" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                <TextBlock x:Name="BackupStatus" Text="备用：Ctrl + Alt + Space  ·  取消：Ctrl + Alt + Esc" Foreground="#667188" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
